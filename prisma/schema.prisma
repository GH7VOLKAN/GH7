// GH7.ai — Prisma Schema
// Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── User & Brand ────────────────────────────────────

model Profile {
  id         String   @id // matches Supabase auth.users.id
  email      String   @unique
  fullName   String?  @map("full_name")
  avatarUrl  String?  @map("avatar_url")
  phone      String?
  smsEnabled       Boolean  @default(false) @map("sms_enabled")
  emailScanComplete Boolean  @default(true)  @map("email_scan_complete")
  emailScoreChange  Boolean  @default(true)  @map("email_score_change")
  emailWeeklyReport Boolean  @default(true)  @map("email_weekly_report")
  plan          String   @default("free") // free, pro, business, agency
  planStartDate DateTime? @map("plan_start_date")
  planEndDate   DateTime? @map("plan_end_date")
  iyzicoCustomerRef    String?  @map("iyzico_customer_ref")
  iyzicoSubscriptionRef String? @map("iyzico_subscription_ref")
  gracePeriodEnd       DateTime? @map("grace_period_end")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  brands   Brand[]
  payments Payment[]

  @@map("profiles")
}

model Brand {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  domain    String
  sector    String?
  city      String?
  profession  String?  // kisisel markalar icin meslek
  specialties String[] // uzmanlik alanlari
  competitorNames String[] @map("competitor_names") // onboarding'de girilen rakip adlari
  type         String   @default("firma") @map("brand_type") // firma, kisisel
  isDefault    Boolean  @default(false) @map("is_default")
  autoScan     Boolean  @default(true)  @map("auto_scan")
  scanInterval String   @default("thrice_weekly") @map("scan_interval") // daily, thrice_weekly, manual
  apiKey       String?  @map("api_key")
  webhookUrl   String?  @map("webhook_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  prompts         Prompt[]
  competitors     Competitor[]
  scans           Scan[]
  actionTasks     ActionTask[]
  auditCategories AuditCategory[]
  sourceDomains   SourceDomain[]
  scoreHistory    ScoreHistory[]
  notifications   Notification[]
  checklistItems  ChecklistItem[]

  @@map("brands")
}

// ─── Prompts ─────────────────────────────────────────

model Prompt {
  id        String   @id @default(cuid())
  brandId   String   @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  text      String
  tags      String[]
  source    String   @default("ai_generated") // ai_generated, dataforseo, sonar, user_added
  category  String?  // lokasyon, urun, karsilastirma, oneri, fiyat, yorum, genel, uzmanlik, itibar
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  results PromptResult[]

  @@map("prompts")
}

model SuggestedPrompt {
  id        String   @id @default(cuid())
  brandId   String   @map("brand_id")
  text      String
  volume    Int      @default(1) // 1-5 scale
  createdAt DateTime @default(now()) @map("created_at")

  @@map("suggested_prompts")
}

// ─── Scans & Results ─────────────────────────────────

model Scan {
  id          String    @id @default(cuid())
  brandId     String    @map("brand_id")
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending, running, completed, failed
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  results PromptResult[]

  @@map("scans")
}

model PromptResult {
  id         String   @id @default(cuid())
  scanId     String   @map("scan_id")
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  promptId   String   @map("prompt_id")
  prompt     Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  platform   String   // chatgpt, claude, gemini, perplexity
  mentioned  Boolean  @default(false)
  position   String?  // "1. sıra", "2. sıra", "bahsediliyor", null
  sentiment  String?  // pozitif, nötr, negatif
  excerpt      String?
  fullResponse String?  @map("full_response")
  citations    Json?    // string[] of cited URLs
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("prompt_results")
}

// ─── Competitors ─────────────────────────────────────

model Competitor {
  id             String @id @default(cuid())
  brandId        String @map("brand_id")
  brand          Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name           String
  domain         String
  mentionScore   Int    @default(0) @map("mention_score")
  readinessScore Int    @default(0) @map("readiness_score")
  // per-platform scores stored as JSON
  platforms      Json?  // { chatgpt: 65, claude: 52, gemini: 58, perplexity: 61 }

  // AI discovery metadata
  reason       String?            // Why this is a competitor (AI explanation)
  products     String[]           // Their product/service lines
  relevance    String  @default("direct") // "direct" | "indirect"
  source       String  @default("manual") // "manual" | "ai_discovered"
  discoveredAt DateTime? @map("discovered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("competitors")
}

// ─── Sources ─────────────────────────────────────────

model SourceDomain {
  id           String   @id @default(cuid())
  brandId      String   @map("brand_id")
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain       String
  type         String   // kurumsal, dizin, ugc, referans, medya
  usagePercent Float    @default(0) @map("usage_percent")
  avgCitations Float    @default(0) @map("avg_citations")
  urls         String[]
  actionNote   String?  @map("action_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("source_domains")
}

// ─── Site Audit ──────────────────────────────────────

model AuditCategory {
  id      String @id @default(cuid())
  brandId String @map("brand_id")
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name    String
  score   Int    @default(0)

  checks AuditCheck[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_categories")
}

model AuditCheck {
  id             String        @id @default(cuid())
  categoryId     String        @map("category_id")
  category       AuditCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label          String
  status         String        // pass, fail, partial
  score          Int           @default(0)
  detail         String?
  recommendation String?
  raasEligible   Boolean       @default(false) @map("raas_eligible")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_checks")
}

// ─── Action Tasks ────────────────────────────────────

model ActionTask {
  id           String  @id @default(cuid())
  brandId      String  @map("brand_id")
  brand        Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  priority     String  // high, medium, low
  title        String
  impact       String
  source       String  // site_audit, ai_action_plan
  detail       String?
  completed    Boolean @default(false)
  raasEligible Boolean @default(false) @map("raas_eligible")

  // AI-generated action plan fields (Claude Opus)
  description      String?
  difficulty       String?  // EASY, MEDIUM, HARD
  estimatedTime    String?  @map("estimated_time")
  canWeDoIt        Boolean  @default(false) @map("can_we_do_it")
  selfServiceSteps Json?    @map("self_service_steps") // string[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("action_tasks")
}

// ─── Notifications ──────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  brandId   String   @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  type      String   // scan_completed, scan_failed, score_up, score_down
  title     String
  message   String
  read      Boolean  @default(false)
  data      Json?    // { scanId, oldScore, newScore }
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

// ─── Verification Codes ─────────────────────────────

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String   @map("code_hash")
  tokenHash String   @map("token_hash")
  attempts  Int      @default(0)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("verification_codes")
}

// ─── Payments ───────────────────────────────────────

model Payment {
  id              String   @id @default(cuid())
  profileId       String   @map("profile_id")
  profile         Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plan            String   // pro, business, agency
  amount          Float
  currency        String   @default("TRY")
  status          String   // pending, success, failed, refunded
  iyzicoPaymentId String?  @map("iyzico_payment_id")
  iyzicoToken     String?  @map("iyzico_token")
  period          String   @default("monthly") // monthly, yearly
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("payments")
}

// ─── Checklist (Gelişim Planı) ───────────────────────

model ChecklistItem {
  id                String   @id @default(cuid())
  brandId           String   @map("brand_id")
  brand             Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  layer             Int      // 1, 2, 3
  itemNumber        String   @map("item_number") // "1.1", "2.3"
  simpleTitle       String   @map("simple_title")
  simpleDescription String   @map("simple_description")
  competitorNote    String?  @map("competitor_note")
  status            String   @default("missing") // complete, warning, missing, locked
  userMarkedDone    Boolean  @default(false) @map("user_marked_done")
  verifiedByAI      Boolean  @default(false) @map("verified_by_ai")
  difficulty        String   @default("MEDIUM") // EASY, MEDIUM, HARD
  impact            String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  estimatedTime     String?  @map("estimated_time")
  technicalDetail   Json?    @map("technical_detail")
  selfServiceSteps  Json?    @map("self_service_steps") // string[]
  canAgencyDo       Boolean  @default(false) @map("can_agency_do")
  agencyPrice       String?  @map("agency_price")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([brandId, itemNumber])
  @@map("checklist_items")
}

// ─── Score History ───────────────────────────────────

model ScoreHistory {
  id             String   @id @default(cuid())
  brandId        String   @map("brand_id")
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  date           DateTime
  mentionScore   Int      @map("mention_score")
  readinessScore Int      @map("readiness_score")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([brandId, date])
  @@map("score_history")
}
