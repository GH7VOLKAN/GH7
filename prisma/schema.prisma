// GH7.ai — Prisma Schema
// Supabase PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── User & Brand ────────────────────────────────────

model Profile {
  id        String   @id // matches Supabase auth.users.id
  email     String   @unique
  fullName  String?  @map("full_name")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  brands Brand[]

  @@map("profiles")
}

model Brand {
  id        String   @id @default(cuid())
  profileId String   @map("profile_id")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name      String
  domain    String
  sector    String?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  prompts       Prompt[]
  competitors   Competitor[]
  scans         Scan[]
  actionTasks   ActionTask[]
  auditCategories AuditCategory[]
  sourceDomains SourceDomain[]
  scoreHistory  ScoreHistory[]

  @@map("brands")
}

// ─── Prompts ─────────────────────────────────────────

model Prompt {
  id        String   @id @default(cuid())
  brandId   String   @map("brand_id")
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  text      String
  tags      String[]
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  results PromptResult[]

  @@map("prompts")
}

model SuggestedPrompt {
  id        String   @id @default(cuid())
  brandId   String   @map("brand_id")
  text      String
  volume    Int      @default(1) // 1-5 scale
  createdAt DateTime @default(now()) @map("created_at")

  @@map("suggested_prompts")
}

// ─── Scans & Results ─────────────────────────────────

model Scan {
  id          String    @id @default(cuid())
  brandId     String    @map("brand_id")
  brand       Brand     @relation(fields: [brandId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending, running, completed, failed
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  results PromptResult[]

  @@map("scans")
}

model PromptResult {
  id         String   @id @default(cuid())
  scanId     String   @map("scan_id")
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  promptId   String   @map("prompt_id")
  prompt     Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  platform   String   // chatgpt, claude, gemini, perplexity
  mentioned  Boolean  @default(false)
  position   String?  // "1. sıra", "2. sıra", "bahsediliyor", null
  sentiment  String?  // pozitif, nötr, negatif
  excerpt    String?
  citations  Json?    // string[] of cited URLs
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("prompt_results")
}

// ─── Competitors ─────────────────────────────────────

model Competitor {
  id             String @id @default(cuid())
  brandId        String @map("brand_id")
  brand          Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name           String
  domain         String
  mentionScore   Int    @default(0) @map("mention_score")
  readinessScore Int    @default(0) @map("readiness_score")
  // per-platform scores stored as JSON
  platforms      Json?  // { chatgpt: 65, claude: 52, gemini: 58, perplexity: 61 }

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("competitors")
}

// ─── Sources ─────────────────────────────────────────

model SourceDomain {
  id           String   @id @default(cuid())
  brandId      String   @map("brand_id")
  brand        Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  domain       String
  type         String   // kurumsal, dizin, ugc, referans, medya
  usagePercent Float    @default(0) @map("usage_percent")
  avgCitations Float    @default(0) @map("avg_citations")
  urls         String[]
  actionNote   String?  @map("action_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("source_domains")
}

// ─── Site Audit ──────────────────────────────────────

model AuditCategory {
  id      String @id @default(cuid())
  brandId String @map("brand_id")
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name    String
  score   Int    @default(0)

  checks AuditCheck[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_categories")
}

model AuditCheck {
  id             String        @id @default(cuid())
  categoryId     String        @map("category_id")
  category       AuditCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  label          String
  status         String        // pass, fail, partial
  score          Int           @default(0)
  detail         String?
  recommendation String?
  raasEligible   Boolean       @default(false) @map("raas_eligible")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audit_checks")
}

// ─── Action Tasks ────────────────────────────────────

model ActionTask {
  id           String  @id @default(cuid())
  brandId      String  @map("brand_id")
  brand        Brand   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  priority     String  // high, medium, low
  title        String
  impact       String
  source       String
  detail       String?
  completed    Boolean @default(false)
  raasEligible Boolean @default(false) @map("raas_eligible")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("action_tasks")
}

// ─── Score History ───────────────────────────────────

model ScoreHistory {
  id             String   @id @default(cuid())
  brandId        String   @map("brand_id")
  brand          Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  date           DateTime
  mentionScore   Int      @map("mention_score")
  readinessScore Int      @map("readiness_score")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([brandId, date])
  @@map("score_history")
}
